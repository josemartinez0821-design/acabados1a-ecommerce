# Variables de entorno del backend (Spring Boot) — EJEMPLO, sin valores reales.
# Spring Boot lee estas variables desde el sistema operativo (no lee este archivo solo):
#   PowerShell:  $env:DB_PASSWORD = "..."        Linux/macOS:  export DB_PASSWORD=...
# En una plataforma de hosting (Railway, etc.) se cargan en el panel de "Variables".
# application.properties.example ya las referencia con la sintaxis ${VARIABLE:valor_por_defecto}.

# Base de datos MariaDB
DB_URL=jdbc:mariadb://localhost:3306/acabados_disenos_1a
DB_USERNAME=usuario_de_la_aplicacion
DB_PASSWORD=CAMBIAR_POR_LA_CLAVE_REAL

# Seguridad (generar con: openssl rand -base64 64  /  openssl rand -base64 48)
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_BASE64_DE_64_BYTES
JWT_EXPIRACION_HORAS=24
CODIGO_VERIFICACION_SECRET=CAMBIAR_POR_UNA_LLAVE_PROPIA

# Correo SMTP (contraseña de aplicación de Google, nunca la clave real de la cuenta)
MAIL_USERNAME=correo@ejemplo.com
MAIL_PASSWORD=CAMBIAR_POR_LA_CONTRASENA_DE_APLICACION

# Puerto HTTP del backend
PORT=8080
