spring.application.name=backend

# RA02 (12/11/2026): los secretos se leen de VARIABLES DE ENTORNO (lista en backend/.env.example).
# Sintaxis ${VARIABLE:valor_por_defecto}: si la variable no existe se usa el valor de la derecha, que
# aquí es solo un marcador. Así el mismo archivo sirve para desarrollo, pruebas y producción.
server.port=${PORT:8080}

# Base de datos real (acabadosydiseños1a24abril.sql), instancia MariaDB local.
spring.datasource.url=${DB_URL:jdbc:mariadb://localhost:3306/acabados_disenos_1a}
spring.datasource.driver-class-name=org.mariadb.jdbc.Driver
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:CAMBIAR_POR_LA_CLAVE_REAL_LOCAL}

# El esquema ya existe - Hibernate solo valida que las entidades @Entity coincidan con las tablas
# reales, nunca crea ni altera nada.
# Todo el frontend (stores, vistas) usa snake_case porque refleja los nombres de columna reales de
# la base de datos (id_usuario, id_rol...) - el backend serializa/deserializa JSON en snake_case
# también para que cualquier endpoint futuro calce sin traducir a mano.
spring.jackson.property-naming-strategy=SNAKE_CASE

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# Subida de imágenes de producto - el límite por defecto de Spring (1MB) es muy chico para una
# foto real de celular sin comprimir.
spring.servlet.multipart.max-file-size=8MB
spring.servlet.multipart.max-request-size=8MB

# Secreto para firmar los JWT de sesión (HS512 con una llave de 512 bits) - generar uno propio, nunca reusar este ejemplo.
# Puede generarse con: openssl rand -base64 64
jwt.secret=${JWT_SECRET:CAMBIAR_POR_UN_SECRETO_PROPIO_BASE64_DE_AL_MENOS_64_BYTES}
jwt.expiracion-horas=${JWT_EXPIRACION_HORAS:24}

# Llave del HMAC con que se guarda el código de verificación/recuperación de contraseña (en la BD
# nunca queda el código en claro). Generar una propia, distinta de jwt.secret:
# openssl rand -base64 48. Si se omite, el backend usa jwt.secret.
codigo-verificacion.secret=${CODIGO_VERIFICACION_SECRET:CAMBIAR_POR_UNA_LLAVE_PROPIA}

# Envío de correos (verificación de registro, recuperar contraseña) vía Gmail SMTP - la contraseña
# es una "contraseña de aplicación" de Google (Cuenta de Google > Seguridad > Verificación en 2
# pasos > Contraseñas de aplicaciones), nunca la contraseña real de la cuenta.
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=${MAIL_USERNAME:CAMBIAR_POR_EL_CORREO_REAL}
spring.mail.password=${MAIL_PASSWORD:CAMBIAR_POR_LA_CONTRASENA_DE_APLICACION}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
# Evita que un envío se quede colgado para siempre si Gmail no responde.
spring.mail.properties.mail.smtp.connectiontimeout=10000
spring.mail.properties.mail.smtp.timeout=10000
spring.mail.properties.mail.smtp.writetimeout=10000
# Consola sin secretos: Hibernate imprime al arrancar la URL de conexión con usuario y contraseña
# de la BD (línea "Database info"), y Spring avisa de un usuario en memoria que no se usa (la
# autenticación es por JWT). Se silencian las dos para poder proyectar la consola sin exponer nada.
logging.level.org.hibernate.orm.connections.pooling=WARN
logging.level.org.springframework.boot.security.autoconfigure.UserDetailsServiceAutoConfiguration=ERROR
# Mismo valor que Spring ya usaba por defecto (true); declararlo explícito solo quita el WARN del arranque.
spring.jpa.open-in-view=true
